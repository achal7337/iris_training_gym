# Copy to .env and fill in only the providers you actually use — every
# role in config/models.yaml defaults to `provider: mock`, so nothing here
# is required for `make test` or `make demo` (zero network, zero cost).
# Fill these in only for a `--live` run against a real provider.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint (e.g. Groq: https://console.groq.com/keys,
# base URL https://api.groq.com/openai/v1)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
